{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Display images on signs in Minecraft",
  "authors": ["TeamFruit", "Kamesuta"],
  "contact": {
    "homepage": "https://github.com/Team-Fruit/SignPicture",
    "sources": "https://github.com/Team-Fruit/SignPicture",
    "issues": "https://github.com/Team-Fruit/SignPicture/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/signpic/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": ["net.teamfruit.signpic.SignPictureFabric"],
    "client": ["net.teamfruit.signpic.SignPictureFabric"]
  },
  "mixins": ["signpic.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=${minecraft_version}",
